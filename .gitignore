# NEXUS: Security & Environment GitIgnore

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Packages & Virtual Environments
.env
.env.*
!.env.example
env/
venv/
ENV/
env.bak/
venv.bak/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
frontend/dist/
frontend/node_modules/

# Operating System & IDE Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Archive & Backup files
*.zip
*.tar.gz
*.tgz
*.rar
*.bak
*.tmp

# Sensitive logs & credentials
*.log
tunnel.log
public_tunnel_url.txt
secrets.json
credentials.json
*.key
*.pem
*.token

# Large generated exports
detections_export.csv
